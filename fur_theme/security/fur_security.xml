<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Visitors and portal users only read published projects -->
    <record id="fur_project_rule_public" model="ir.rule">
        <field name="name">Fur Project: published only</field>
        <field name="model_id" ref="model_fur_project"/>
        <field name="domain_force">[('website_published', '=', True)]</field>
        <field name="groups" eval="[(4, ref('base.group_public')), (4, ref('base.group_portal'))]"/>
    </record>
    <record id="fur_project_rule_employee" model="ir.rule">
        <field name="name">Fur Project: all for employees</field>
        <field name="model_id" ref="model_fur_project"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
