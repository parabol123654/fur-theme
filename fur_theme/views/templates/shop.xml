<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- /shop and /shop/category/<slug>: Fur banner with breadcrumb above the grid,
     sub-category pills and the service strip below. -->
<template id="products" inherit_id="website_sale.products" name="Fur Shop Page">
    <xpath expr="//div[@id='oe_structure_website_sale_products_1']" position="after">
      <!-- see template shop_product_buttons -->
      <t t-set="fur_tile_cart" t-value="website.fur_enabled and not is_view_active('website_sale.products_add_to_cart')"/>
      <t t-if="website.fur_enabled">
        <t t-set="fur_products_label">Products</t>
        <t t-set="fur_all_products_label">All products</t>
        <t t-set="fur_crumbs" t-value="[(fur_products_label, '/shop' if category else None)] + [
            (c.name, None if c == category else c.website_url) for c in (category.parents_and_self if category else [])
        ]"/>
        <t t-call="fur_theme.page_banner"><t t-set="banner_title" t-value="category.name if category else fur_all_products_label"/><t t-set="banner_crumbs" t-value="fur_crumbs"/></t>
        <div t-if="category and category.child_id.filtered_domain(website.website_domain())" class="container o_fur_subcategs">
            <div class="o_fur_filter_pills">
                <a t-att-href="keep(category.website_url)" class="o_fur_pill_filter active" t-out="category.name"/>
                <t t-foreach="category.child_id.filtered_domain(website.website_domain())" t-as="child_categ">
                    <a t-att-href="keep(child_categ.website_url)" class="o_fur_pill_filter" t-field="child_categ.name"/>
                </t>
            </div>
        </div>
      </t>
    </xpath>
    <xpath expr="//div[@id='wrap']" position="attributes">
        <!-- static class: every rule of fur_shop.scss is scoped under .o_fur -->
        <attribute name="class" add="o_fur_shop" separator=" "/>
    </xpath>
    <xpath expr="//div[@id='oe_structure_website_sale_products_2']" position="before">
        <t t-if="website.fur_enabled" t-call="fur_theme.services_strip"/>
    </xpath>
</template>

<!-- Product tile: short name clamped to two lines + the reference on its own line -->
<template id="products_item" inherit_id="website_sale.products_item" name="Fur Tile Name">
    <xpath expr="//h6[hasclass('o_wsale_products_item_title')]" position="attributes">
        <attribute name="t-att-title">product.name if website.fur_enabled else None</attribute>
    </xpath>
    <xpath expr="//h6[hasclass('o_wsale_products_item_title')]/a[@t-field='product.name']" position="replace">
        <a t-if="website.fur_enabled" class="text-decoration-none" itemprop="name" t-att-href="product_href" t-att-content="product.name">
            <span class="o_fur_tile_name" t-out="product._fur_short_name()"/>
        </a>
        <t t-else="">$0</t>
    </xpath>
    <xpath expr="//h6[hasclass('o_wsale_products_item_title')]" position="after">
        <div t-if="website.fur_enabled and product.default_code" class="o_fur_product_code">Code: <t t-out="product.default_code"/></div>
    </xpath>
</template>

<!-- Product tile: cart button with the Fur look (icon only), always shown.
     Same markup as Odoo's "Add to Cart" option of the shop page
     (website_sale.products_add_to_cart, off by default), which stays the one
     shown when it is switched on. -->
<template id="shop_product_buttons" inherit_id="website_sale.products_item" name="Fur Tile Buttons">
    <xpath expr="//div[hasclass('o_wsale_product_btn')]" position="inside">
        <t t-if="fur_tile_cart">
            <t t-set="product_variant_id" t-value="product._get_first_possible_variant_id()"/>
            <input name="product_id" t-att-value="product_variant_id" type="hidden"/>
            <t t-if="product_variant_id and template_price_vals['price_reduce'] or not website.prevent_zero_price_sale">
                <a t-if="product._website_show_quick_add()"
                   href="#" role="button" class="btn btn-primary a-submit" aria-label="Add to cart" title="Add to cart">
                    <t t-call="fur_theme.icon"><t t-set="icon" t-value="'cart'"/></t>
                </a>
            </t>
        </t>
    </xpath>
</template>

</odoo>
