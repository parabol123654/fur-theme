<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Contact page: the form only (Odoo's picture banner and sample company
     address are removed). -->
<template id="contactus" inherit_id="website.contactus" name="Fur Contact Us">
    <xpath expr="//section[hasclass('s_title')]" position="replace"/>
    <xpath expr="//p[hasclass('lead')]" position="before">
        <h1>Contact us</h1>
    </xpath>
    <xpath expr="//section[hasclass('s_text_block')]//div[hasclass('col-lg-4')]" position="replace"/>
</template>
</odoo>
