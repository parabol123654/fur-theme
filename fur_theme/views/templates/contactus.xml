<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Contact page: the form only (Odoo's sample "50,000+ companies" title, FAQ,
     separator and San Francisco map are removed). -->
<template id="contactus" inherit_id="website.contactus" name="Fur Contact Us">
    <xpath expr="//section[hasclass('s_title')]" position="replace"/>
    <xpath expr="//section[hasclass('s_faq_list')]" position="replace"/>
    <xpath expr="//div[hasclass('s_hr')]" position="replace"/>
    <xpath expr="//section[hasclass('s_accordion_image')]" position="replace"/>
</template>
</odoo>
