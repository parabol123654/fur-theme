<!-- =====================================================================
     Copyright bar: languages (left), copyright (centre), "Powered by Odoo"
     (right).
     ===================================================================== -->
<template id="copyright_bar" name="Fur Copyright Bar">
    <div class="o_footer_copyright o_fur_copyright">
        <div class="container o_fur_copyright_row">
            <div class="o_fur_copyright_langs d-print-none">
                <!-- the footer is cached, these links depend on the page -->
                <t t-nocache="The language links hold the URL of the page." t-if="len(languages) &gt; 1">
                    <t t-foreach="website._fur_header_languages(languages)" t-as="lg">
                        <span t-if="not lg_first" class="o_fur_copyright_sep" aria-hidden="true">|</span>
                        <a t-att-href="url_for(request.httprequest.path + '?' + keep_query(), lang_code=lg.code)"
                           t-attf-class="js_change_lang #{'active' if lg.code == lang else ''}"
                           t-att-data-url_code="lg.url_code" t-out="lg.name.split('/').pop().strip()"/>
                    </t>
                </t>
            </div>
            <div class="o_fur_copyright_name">
                Copyright &amp;copy; <span t-field="res_company.name"/>
            </div>
            <div class="o_fur_copyright_brand">
                <t t-call="web.brand_promotion"/>
            </div>
        </div>
    </div>
</template>

<template id="layout" inherit_id="website.layout" name="Fur Layout" priority="99">
    <!-- Odoo's header and footer stay for websites that switched Fur off
         (Website settings > Fur Theme). -->
    <xpath expr="//header" position="before">
        <t t-set="fur_nav_categories" t-value="website._fur_home_categories(limit=12) if website.fur_enabled else []"/>
        <header t-if="not no_header and website.fur_enabled" id="top" data-anchor="true" data-name="Header"
                class="o_fur_header o_no_autohide_menu">
            <t t-call="fur_theme.header"/>
        </header>
    </xpath>
    <xpath expr="//header[not(hasclass('o_fur_header'))]" position="attributes">
        <attribute name="t-if">not no_header and not website.fur_enabled</attribute>
    </xpath>
    <xpath expr="//div[@id='footer']" position="attributes">
        <attribute name="t-if">not no_footer and not website.fur_enabled</attribute>
    </xpath>
    <xpath expr="//div[@id='footer']" position="before">
        <t t-if="website.fur_enabled" t-call="fur_theme.footer"/>
        <t t-if="website.fur_enabled" t-call="fur_theme.contact_float"/>
    </xpath>
    <xpath expr="//div[@id='wrapwrap']" position="attributes">
        <attribute name="t-attf-class" add="#{'o_fur' if website.fur_enabled else ''}" separator=" "/>
    </xpath>
    <!-- Copyright bar: Fur's own (template copyright_bar) -->
    <xpath expr="//div[hasclass('o_footer_copyright')]" position="attributes">
        <attribute name="t-if">not no_copyright and not website.fur_enabled</attribute>
    </xpath>
    <xpath expr="//div[hasclass('o_footer_copyright')]" position="after">
        <t t-if="not no_copyright and website.fur_enabled" t-call="fur_theme.copyright_bar"/>
    </xpath>
</template>

</odoo>
