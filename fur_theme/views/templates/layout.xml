<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- =====================================================================
     Icons: one template, pick the glyph with `icon`. 24x24, stroke based,
     colour follows `currentColor`.
     ===================================================================== -->
<template id="icon" name="Fur Icon">
    <svg t-attf-class="o_fur_icon #{icon_class or ''}" xmlns="http://www.w3.org/2000/svg"
         viewBox="0 0 24 24" fill="none" stroke="currentColor" t-att-stroke-width="icon_stroke or 2"
         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <t t-if="icon == 'menu'"><path d="M4 6h16M4 12h16M4 18h16"/></t>
        <t t-elif="icon == 'cart'"><circle cx="9" cy="20" r="1.4"/><circle cx="18" cy="20" r="1.4"/><path d="M2.5 3.5h2.6l2.4 11.2a1.6 1.6 0 0 0 1.6 1.3h8.7a1.6 1.6 0 0 0 1.6-1.2l1.6-7H6"/></t>
        <t t-elif="icon == 'user'"><circle cx="12" cy="8" r="4"/><path d="M4 21c.9-4 4.1-6 8-6s7.1 2 8 6"/></t>
        <t t-elif="icon == 'search'"><circle cx="11" cy="11" r="7"/><path d="m20.5 20.5-4.5-4.5"/></t>
        <t t-elif="icon == 'arrow'"><path d="M5 12h14M13 6l6 6-6 6"/></t>
        <t t-elif="icon == 'chevron'"><path d="m9 6 6 6-6 6"/></t>
        <t t-elif="icon == 'truck'"><path d="M2 6.5h11v9H2zM13 9.5h4.5l3.5 3.6v2.4h-8"/><circle cx="6.5" cy="17.5" r="1.8"/><circle cx="17" cy="17.5" r="1.8"/></t>
        <t t-elif="icon == 'shield'"><path d="M12 3 4.5 6v5.5c0 4.6 3.1 8.4 7.5 9.5 4.4-1.1 7.5-4.9 7.5-9.5V6z"/><path d="m8.8 12.2 2.2 2.2 4.4-4.6"/></t>
        <t t-elif="icon == 'gear'"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></t>
        <t t-elif="icon == 'headset'"><path d="M4 14v-2a8 8 0 0 1 16 0v2"/><path d="M4 14h3v5H5.5A1.5 1.5 0 0 1 4 17.5zM20 14h-3v5h1.5a1.5 1.5 0 0 0 1.5-1.5z"/><path d="M17 19c0 1.2-1.6 2-4 2"/></t>
        <t t-elif="icon == 'heart'"><path d="M12 20.5s-7.5-4.4-7.5-10.1A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7.5 2.8c0 5.7-7.5 10.1-7.5 10.1z"/></t>
        <t t-elif="icon == 'phone'"><path d="M21 16.5v3a2 2 0 0 1-2.2 2A19.8 19.8 0 0 1 2.5 5.2 2 2 0 0 1 4.5 3h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.4 10.9a16 16 0 0 0 4.7 4.7l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"/></t>
        <t t-elif="icon == 'mail'"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></t>
        <t t-elif="icon == 'pin'"><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21z"/><circle cx="12" cy="9.5" r="2.5"/></t>
        <t t-elif="icon == 'clock'"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></t>
        <t t-elif="icon == 'close'"><path d="M6 6l12 12M18 6 6 18"/></t>
        <t t-elif="icon == 'grid'"><rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/></t>
        <t t-elif="icon == 'check'"><path d="m5 12.5 4.5 4.5L19 7.5"/></t>
        <t t-elif="icon == 'lock'"><rect x="4.5" y="10.5" width="15" height="10" rx="2"/><path d="M8 10.5V7.5a4 4 0 0 1 8 0v3"/></t>
        <t t-elif="icon == 'return'"><path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="m8 5-4 4 4 4"/></t>
        <t t-elif="icon == 'home'"><path d="M3.5 11 12 4l8.5 7"/><path d="M5.5 9.5V20h13V9.5"/><path d="M10 20v-5.5h4V20"/></t>
        <t t-elif="icon == 'ruler'"><path d="m3 17 14-14 4 4L7 21z"/><path d="m7 13 2 2M10 10l2 2M13 7l2 2"/></t>
    </svg>
</template>

<!-- Brand: the website logo (Website > Settings > Logo). On a dark background
     (`_logo_bg` 'navy', the footer) it sits on a white card so that any logo
     stays readable. Params: _logo_bg, _brand_class. -->
<template id="brand" name="Fur Brand">
    <a href="/" t-attf-class="o_fur_brand text-decoration-none #{'o_fur_brand_on_dark' if _logo_bg == 'navy' and not website.fur_footer_logo else ''} #{_brand_class or ''}"
       t-att-aria-label="website._fur_brand()">
        <img t-if="_logo_bg == 'navy' and website.fur_footer_logo"
             t-att-src="website.image_url(website, 'fur_footer_logo')" class="o_fur_logo"
             t-att-alt="website._fur_brand()" loading="lazy"/>
        <img t-elif="website.logo" t-att-src="website.image_url(website, 'logo')" class="o_fur_logo"
             t-att-alt="website._fur_brand()" loading="eager"/>
        <span t-else="" class="o_fur_wordmark" t-out="website._fur_brand()"/>
    </a>
</template>

<!-- Section title used everywhere: "PRODUCT <accent>CATEGORIES</accent>" -->
<template id="section_title" name="Fur Section Title">
    <div class="o_fur_section_head">
        <h2 class="o_fur_section_title"><t t-out="0"/></h2>
        <a t-if="see_all_url" t-att-href="see_all_url" class="o_fur_see_all">
            <span>See all</span>
            <t t-call="fur_theme.icon"><t t-set="icon" t-value="'arrow'"/><t t-set="icon_class" t-value="'o_fur_icon_sm'"/></t>
        </a>
    </div>
</template>

<!-- =====================================================================
     Header
     ===================================================================== -->
<!-- Odoo 16 caches whole pages (the product page, t-cache): what depends on
     the visitor or on the request is in a t-nocache, where only the values
     given to the page are known (website, request, user_id, languages...). -->
<template id="header" name="Fur Header">
    <div class="o_fur_topbar">
        <div class="container o_fur_topbar_inner">
            <button type="button" class="o_fur_burger btn" data-bs-toggle="offcanvas"
                    data-bs-target="#o_fur_offcanvas" aria-controls="o_fur_offcanvas" aria-label="Menu">
                <t t-call="fur_theme.icon"><t t-set="icon" t-value="'menu'"/></t>
            </button>
            <t t-call="fur_theme.brand"/>
            <form class="o_fur_search" action="/shop" method="get" role="search">
                <t t-call="fur_theme.icon"><t t-set="icon" t-value="'search'"/><t t-set="icon_class" t-value="'o_fur_search_icon'"/></t>
                <input type="search" name="search" class="form-control" t-att-value="search"
                       t-nocache="The searched text is the visitor's."
                       placeholder="Search furniture..." aria-label="Search furniture"/>
                <button type="submit" class="o_fur_search_btn btn" aria-label="Search">
                    <t t-call="fur_theme.icon"><t t-set="icon" t-value="'search'"/></t>
                </button>
            </form>
            <!-- right side, two rows on large screens:
                 links + languages, then hotline, cart and account -->
            <ul class="o_fur_toplinks list-unstyled">
                <li class="o_fur_toplink"><a href="/projects">Projects</a></li>
                <li class="o_fur_toplink"><a href="/contactus">Contact</a></li>
                <t t-nocache="The language links hold the URL of the page."
                   t-foreach="website._fur_header_languages(languages)" t-as="lg">
                    <li class="o_fur_lang_item">
                        <a t-att-href="url_for(request.httprequest.path + '?' + keep_query(), lang_code=lg.code)"
                           t-attf-class="o_fur_pill_flag js_change_lang #{'active' if lg.code == lang else ''}"
                           t-att-data-url_code="lg.url_code" t-att-title="lg.name.split('/').pop()"
                           t-att-aria-label="lg.name.split('/').pop()">
                            <img t-att-src="website._fur_flag_url(lg)" class="o_fur_flag" alt="" loading="lazy"/>
                        </a>
                    </li>
                </t>
            </ul>
            <ul class="o_fur_actions list-unstyled">
                <li t-if="website._fur_tel_url()" class="o_fur_action_hotline">
                    <a t-att-href="website._fur_tel_url()" class="o_fur_action" data-no-post-process="1">
                        <span class="o_fur_pill o_fur_pill_round"><t t-call="fur_theme.icon"><t t-set="icon" t-value="'phone'"/></t></span>
                        <div class="o_fur_action_text">
                            <div class="o_fur_action_kicker">Hotline support</div>
                            <b t-out="website._fur_hotline()"/>
                        </div>
                    </a>
                </li>
                <li class="o_wsale_my_cart">
                    <a href="/shop/cart" class="o_fur_action" aria-label="Cart">
                        <span class="o_fur_pill o_fur_pill_round o_fur_pill_cart">
                            <t t-call="fur_theme.icon"><t t-set="icon" t-value="'cart'"/></t>
                            <t t-nocache="The number of products is dynamic, this rendering cannot be cached.">
                                <t t-set="fur_cart_qty" t-value="(
                                    request.session['website_sale_cart_quantity']
                                    if 'website_sale_cart_quantity' in request.session
                                    else website.sale_get_order().cart_quantity
                                ) or 0"/>
                                <sup class="my_cart_quantity o_fur_badge" t-out="fur_cart_qty"
                                     t-att-data-order-id="request.session.get('sale_order_id') if fur_cart_qty else None"/>
                            </t>
                        </span>
                        <div class="o_fur_action_text o_fur_action_label">Cart</div>
                    </a>
                </li>
                <t t-nocache="Signed in or not, whatever the page cache." t-if="user_id._is_public()">
                    <li>
                        <a href="/web/login" class="o_fur_action" aria-label="Sign in">
                            <span class="o_fur_pill o_fur_pill_round"><t t-call="fur_theme.icon"><t t-set="icon" t-value="'user'"/></t></span>
                            <div class="o_fur_action_text o_fur_action_label">Sign in</div>
                        </a>
                    </li>
                </t>
                <!-- renders nothing for a visitor, in a t-nocache of its own -->
                <t t-call="portal.user_dropdown">
                    <t t-set="_item_class" t-valuef="dropdown o_fur_user"/>
                    <t t-set="_no_caret" t-value="True"/>
                    <t t-set="_icon" t-value="True"/>
                    <t t-set="_link_class" t-valuef="o_fur_pill o_fur_pill_round"/>
                    <t t-set="_dropdown_menu_class" t-valuef="dropdown-menu-end"/>
                </t>
            </ul>
        </div>
    </div>
    <nav class="o_fur_menubar" aria-label="Main">
        <div class="container">
            <!-- id: Odoo 16's menu script looks for #top_menu in the header -->
            <ul id="top_menu" class="o_fur_menu top_menu list-unstyled" role="menu">
                <t t-foreach="website.menu_id.child_id.filtered(lambda m: m.is_visible)" t-as="submenu">
                    <!-- An entry linking to a shop category drops its sub-categories down on hover -->
                    <t t-set="fur_sub_categs" t-value="website._fur_menu_categories(submenu) if not submenu.child_id else []"/>
                    <li role="presentation" t-attf-class="o_fur_menu_item #{submenu.child_id and 'dropdown' or ''} #{fur_sub_categs and 'o_fur_menu_has_panel' or ''}">
                        <t t-if="submenu.child_id">
                            <a href="#" role="menuitem" data-bs-toggle="dropdown"
                               t-attf-class="o_fur_menu_link dropdown-toggle #{website._fur_menu_is_active(submenu) and 'active' or ''}">
                                <span t-field="submenu.name"/>
                            </a>
                            <div class="dropdown-menu">
                                <t t-foreach="submenu.child_id.filtered(lambda m: m.is_visible)" t-as="child">
                                    <a t-att-href="child.clean_url()" t-attf-class="dropdown-item #{website._fur_menu_is_active(child) and 'active' or ''}"
                                       t-att-target="'_blank' if child.new_window else None" t-field="child.name"/>
                                </t>
                            </div>
                        </t>
                        <t t-else="">
                            <a t-if="submenu.url == '/'" href="/" role="menuitem"
                               t-attf-class="o_fur_menu_link o_fur_menu_home #{website._fur_menu_is_active(submenu) and 'active' or ''}"
                               t-att-title="submenu.name" t-att-aria-label="submenu.name">
                                <t t-call="fur_theme.icon"><t t-set="icon" t-value="'home'"/></t>
                            </a>
                            <a t-else="" t-att-href="submenu.clean_url()" role="menuitem"
                               t-attf-class="o_fur_menu_link #{website._fur_menu_is_active(submenu) and 'active' or ''}"
                               t-att-target="'_blank' if submenu.new_window else None"
                               t-att-aria-haspopup="'true' if fur_sub_categs else None">
                                <span t-field="submenu.name"/>
                            </a>
                            <ul t-if="fur_sub_categs" class="o_fur_menu_panel list-unstyled" role="menu">
                                <li t-foreach="fur_sub_categs" t-as="categ"
                                    t-attf-class="o_fur_menu_panel_item #{categ.child_id and 'o_fur_menu_panel_parent' or ''}">
                                    <a t-att-href="categ.website_url" role="menuitem" class="o_fur_menu_panel_link">
                                        <span t-field="categ.name"/>
                                        <t t-if="categ.child_id" t-call="fur_theme.icon"><t t-set="icon" t-value="'chevron'"/><t t-set="icon_class" t-value="'o_fur_icon_sm'"/></t>
                                    </a>
                                    <ul t-if="categ.child_id" class="o_fur_menu_flyout list-unstyled" role="menu">
                                        <li t-foreach="categ.child_id.sorted(lambda c: (c.sequence, c.id))" t-as="grandchild">
                                            <a t-att-href="grandchild.website_url" role="menuitem" class="o_fur_menu_panel_link">
                                                <span t-field="grandchild.name"/>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            </ul>
                        </t>
                    </li>
                </t>
            </ul>
        </div>
    </nav>

    <!-- Off-canvas menu opened by the hamburger -->
    <div class="offcanvas offcanvas-start o_fur_offcanvas" tabindex="-1" id="o_fur_offcanvas" aria-label="Menu">
        <div class="offcanvas-header">
            <t t-call="fur_theme.brand"/>
            <button type="button" class="btn o_fur_offcanvas_close" data-bs-dismiss="offcanvas" aria-label="Close">
                <t t-call="fur_theme.icon"><t t-set="icon" t-value="'close'"/></t>
            </button>
        </div>
        <div class="offcanvas-body">
            <ul class="list-unstyled o_fur_offcanvas_menu">
                <t t-foreach="website.menu_id.child_id.filtered(lambda m: m.is_visible)" t-as="submenu">
                    <t t-set="fur_sub_categs" t-value="website._fur_menu_categories(submenu) if not submenu.child_id else []"/>
                    <li t-attf-class="#{fur_sub_categs and 'o_fur_offcanvas_has_sub' or ''}">
                        <a t-att-href="submenu.clean_url() if not submenu.child_id else '#'"
                           t-attf-class="#{website._fur_menu_is_active(submenu) and 'active' or ''}" t-field="submenu.name"/>
                        <button t-if="fur_sub_categs" type="button" class="btn o_fur_offcanvas_toggle collapsed"
                                data-bs-toggle="collapse" t-attf-data-bs-target="#o_fur_offcanvas_sub_#{submenu.id}"
                                aria-expanded="false" t-attf-aria-controls="o_fur_offcanvas_sub_#{submenu.id}"
                                aria-label="Show sub-categories">
                            <t t-call="fur_theme.icon"><t t-set="icon" t-value="'chevron'"/><t t-set="icon_class" t-value="'o_fur_icon_sm'"/></t>
                        </button>
                        <ul t-if="submenu.child_id" class="list-unstyled">
                            <li t-foreach="submenu.child_id.filtered(lambda m: m.is_visible)" t-as="child">
                                <a t-att-href="child.clean_url()" t-field="child.name"/>
                            </li>
                        </ul>
                        <ul t-if="fur_sub_categs" class="list-unstyled collapse" t-attf-id="o_fur_offcanvas_sub_#{submenu.id}">
                            <li t-foreach="fur_sub_categs" t-as="categ">
                                <a t-att-href="categ.website_url" t-field="categ.name"/>
                                <ul t-if="categ.child_id" class="list-unstyled o_fur_offcanvas_sub2">
                                    <li t-foreach="categ.child_id.sorted(lambda c: (c.sequence, c.id))" t-as="grandchild">
                                        <a t-att-href="grandchild.website_url" t-field="grandchild.name"/>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                </t>
                <li><a href="/projects">Projects</a></li>
                <li><a href="/contactus">Contact</a></li>
            </ul>
            <div t-if="fur_nav_categories" class="o_fur_offcanvas_categs">
                <h6>Product categories</h6>
                <ul class="list-unstyled">
                    <li t-foreach="fur_nav_categories" t-as="categ">
                        <a t-att-href="categ.website_url">
                            <span t-field="categ.name"/>
                            <t t-call="fur_theme.icon"><t t-set="icon" t-value="'chevron'"/><t t-set="icon_class" t-value="'o_fur_icon_sm'"/></t>
                        </a>
                    </li>
                </ul>
            </div>
            <a t-if="website.fur_hotline or res_company.phone"
               t-attf-href="tel:#{website.fur_hotline or res_company.phone}" data-no-post-process="1" class="o_fur_offcanvas_hotline">
                <t t-call="fur_theme.icon"><t t-set="icon" t-value="'phone'"/></t>
                <span>Hotline: <b t-out="website.fur_hotline or res_company.phone"/></span>
            </a>
        </div>
    </div>
</template>

<!-- =====================================================================
     Footer
     ===================================================================== -->
<template id="footer" name="Fur Footer">
    <div id="footer" class="o_fur_footer" t-if="not no_footer">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-4">
                    <t t-call="fur_theme.brand"><t t-set="_logo_bg" t-value="'navy'"/></t>
                    <p class="o_fur_footer_about">
                        Modern, refined furniture for your home and office. Designed, made
                        and installed turnkey nationwide.
                    </p>
                </div>
                <div t-if="fur_nav_categories" class="col-6 col-lg-2">
                    <h6>Products</h6>
                    <ul class="list-unstyled">
                        <li t-foreach="fur_nav_categories[:6]" t-as="categ">
                            <a t-att-href="categ.website_url" t-field="categ.name"/>
                        </li>
                    </ul>
                </div>
                <div class="col-6 col-lg-2">
                    <h6>Support</h6>
                    <ul class="list-unstyled">
                        <li><a href="/shop">Shop</a></li>
                        <li><a href="/projects">Projects</a></li>
                        <li><a href="/my/orders">Track my order</a></li>
                        <li><a href="/delivery-installation">Delivery &amp; installation policy</a></li>
                        <li t-if="website._fur_has_terms_page()"><a href="/terms">Terms</a></li>
                        <li><a href="/contactus">Contact</a></li>
                    </ul>
                </div>
                <div t-if="website.fur_hotline or res_company.phone or res_company.email or website.fur_opening_hours" class="col-lg-4">
                    <h6>Contact</h6>
                    <ul class="list-unstyled o_fur_footer_contact">
                        <li t-if="website.fur_hotline or res_company.phone">
                            <t t-call="fur_theme.icon"><t t-set="icon" t-value="'phone'"/></t>
                            <a t-attf-href="tel:#{website.fur_hotline or res_company.phone}" data-no-post-process="1" t-out="website.fur_hotline or res_company.phone"/>
                        </li>
                        <li t-if="res_company.email">
                            <t t-call="fur_theme.icon"><t t-set="icon" t-value="'mail'"/></t>
                            <a t-attf-href="mailto:#{res_company.email}" t-out="res_company.email"/>
                        </li>
                    </ul>
                    <t t-if="website.fur_opening_hours">
                        <h6 class="o_fur_footer_hours_title">Opening hours</h6>
                        <ul class="list-unstyled o_fur_footer_contact o_fur_footer_hours">
                            <li>
                                <t t-call="fur_theme.icon"><t t-set="icon" t-value="'clock'"/></t>
                                <span t-field="website.fur_opening_hours"/>
                            </li>
                        </ul>
                    </t>
                </div>
            </div>
        </div>
    </div>
</template>

<!-- =====================================================================
     Floating contact buttons (bottom right): Messenger, chat on Zalo (one
     button per Zalo number), call the hotline
     ===================================================================== -->
<!-- data-no-post-process on the "tel:" links: Odoo 16 rewrites the links of a
     page and takes a digits-only "tel:0901234567" for a relative URL. -->
<template id="contact_float" name="Fur Floating Contact Buttons">
    <t t-set="fur_tel_url" t-value="website._fur_tel_url()"/>
    <t t-set="fur_zalo_urls" t-value="website._fur_zalo_urls()"/>
    <t t-set="fur_whatsapp_url" t-value="website._fur_whatsapp_url()"/>
    <div t-if="fur_tel_url or fur_zalo_urls or fur_whatsapp_url or website.fur_messenger"
         class="o_fur_contact_float o_not_editable d-print-none">
        <a t-if="website.fur_messenger" t-att-href="website.fur_messenger" target="_blank" rel="noopener"
