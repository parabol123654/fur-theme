<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Odoo 14 has no "assets" key in the manifest: the style and script files
     are added to the bundles by inheriting their templates. -->

<!-- right after website's own primary_variables.scss, before the user's values -->
<template id="_assets_primary_variables" inherit_id="website._assets_primary_variables">
    <xpath expr="//link[@href='/website/static/src/scss/primary_variables.scss']" position="after">
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/primary_variables.scss"/>
    </xpath>
</template>

<template id="assets_frontend" inherit_id="website.assets_frontend" name="Fur Assets">
    <xpath expr="//link[last()]" position="after">
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fonts.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_common.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_header.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_footer.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_home.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_shop.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_product.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_checkout.scss"/>
        <link rel="stylesheet" type="text/scss" href="/fur_theme/static/src/scss/fur_projects.scss"/>
    </xpath>
    <xpath expr="//script[last()]" position="after">
        <script type="text/javascript" src="/fur_theme/static/src/js/offcanvas.js"/>
        <script type="text/javascript" src="/fur_theme/static/src/js/product_card.js"/>
        <script type="text/javascript" src="/fur_theme/static/src/js/product_sticky_buy.js"/>
        <script type="text/javascript" src="/fur_theme/static/src/js/search_suggest.js"/>
    </xpath>
</template>

<template id="assets_tests" inherit_id="web.assets_tests" name="Fur Assets Tests">
    <xpath expr="." position="inside">
        <script type="text/javascript" src="/fur_theme/static/tests/tours/checkout_tour.js"/>
    </xpath>
</template>

</odoo>
